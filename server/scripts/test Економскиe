// Real ingestion smoke test against the configured DATABASE_URL.
// Defaults to the local dev Postgres when LOCAL=1.
process.env.LOCAL = process.env.LOCAL ?? '1';
if (process.env.LOCAL === '1') {
    process.env.DATABASE_URL = process.env.DATABASE_URL ?? 'postgresql://postgres:postgres@localhost:5433/job_hunter_dev';
    process.env.DIRECT_URL = process.env.DIRECT_URL ?? 'postgresql://postgres:postgres@localhost:5433/job_hunter_dev';
}

async function main() {
    // Dynamic imports so Prisma loads after the env overrides above.
    const { runIngestion } = await import('../src/jobs/services/ingestion.service');
    const { default: prisma } = await import('../src/lib/prisma');

    const before = await prisma.job.count();
    console.log('JOBS_BEFORE', before);
    console.log('RUNNING_INGESTION');
    const results = await runIngestion(undefined, { force: true });
    for (const r of results) {
        console.log(
            `RESULT source=${r.source} ok=${r.success} fetched=${r.fetched} new=${r.saved} ` +
            `dupes=${r.duplicates} expired=${r.expired} errors=${r.errors} msg=${r.errorMessage ?? ''} skipped=${r.skipped}`,
        );
    }
    const after = await prisma.job.count();
    console.log('JOBS_AFTER', after);

    const bySource = await prisma.job.groupBy({ by: ['source'], _count: { _all: true } });
    console.log('BY_SOURCE', JSON.stringify(bySource));

    const byCountry = await prisma.job.groupBy({ by: ['country'], _count: { _all: true }, orderBy: { _count: { country: 'desc' } }, take: 15 });
    console.log('BY_COUNTRY', JSON.stringify(byCountry));

    const sample = await prisma.job.findMany({ where: { source: { not: 'arbeitnow' } }, take: 5, select: { source: true, title: true, companyName: true, country: true, remoteType: true, verificationStatus: true, matchScore: true, postedAt: true, originalUrl: true } });
    console.log('SAMPLE_NON_ARBEITNOW', JSON.stringify(sample, null, 2));

    const health = await prisma.sourceHealth.findMany({ orderBy: { sourceName: 'asc' } });
    console.log('HEALTH', JSON.stringify(health.map((h) => ({ source: h.sourceName, status: h.status, fetched: h.jobsFetched, new: h.jobsNew, dupes: h.jobsDuplicate, active: h.jobsActive })))));
}
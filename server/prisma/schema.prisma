// Prisma Schema — AI Developer Job Hunter
// Phase 1 + Phase 2 + Phase 3

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Enums ────────────────────────────────────────────────────────────────

enum ExperienceLevel {
  BEGINNER
  JUNIOR
  MID_LEVEL
  SENIOR
  LEAD
}

enum Specialization {
  FRONTEND
  BACKEND
  FULL_STACK
  MOBILE
  DEVOPS_CLOUD
  SOFTWARE_ENGINEERING
  OTHER
}

enum SkillCategory {
  FRONTEND
  BACKEND
  MOBILE
  DATABASE
  CLOUD_DEVOPS
  OTHER
}

enum SkillProficiency {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  FREELANCE
  INTERNSHIP
  TEMPORARY
}

enum WorkPreference {
  REMOTE
  HYBRID
  ON_SITE
}

enum SalaryPeriod {
  HOURLY
  MONTHLY
  YEARLY
}

enum Availability {
  IMMEDIATELY
  WITHIN_2_WEEKS
  WITHIN_1_MONTH
  MORE_THAN_1_MONTH
}

// Phase 3 enums
enum JobStatus {
  ACTIVE
  EXPIRED
  REMOVED
  ERROR
}

enum RemoteType {
  REMOTE
  HYBRID
  ON_SITE
  UNKNOWN
}

enum ApplicationMethod {
  DIRECT
  EXTERNAL
  MANUAL
  UNKNOWN
}

// Phase 4 enums
enum ApplicationStatus {
  SAVED
  INTERESTED
  PREPARING
  APPLIED
  INTERVIEW
  ASSESSMENT
  OFFER
  REJECTED
  WITHDRAWN
  CLOSED
}

enum InterviewType {
  PHONE
  VIDEO
  ONSITE
  CODING_ASSESSMENT
  TECHNICAL
  PANEL
  OTHER
}

// Job freshness / verification
enum VerificationStatus {
  ACTIVE
  EXPIRED
  CLOSED
  UNVERIFIED
}

// ── Models ───────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile            DeveloperProfile?
  applicationProfile ApplicationProfile?
  resumes            Resume[]
  coverLetters       CoverLetter[]
  applications       JobApplication[]

  @@map("users")
}

model DeveloperProfile {
  id                       String           @id @default(cuid())
  userId                   String           @unique
  professionalTitle        String?
  bio                      String?
  yearsOfExperience        Int?
  experienceLevel          ExperienceLevel?
  primarySpecialization    Specialization?
  secondarySpecializations Specialization[]
  location                 String?
  country                  String?
  timezone                 String?
  remoteWorldwide          Boolean          @default(false)
  preferredCountries       String[]
  preferredCities          String[]
  jobTypes                 JobType[]
  workPreferences          WorkPreference[]
  salaryMin                Int?
  salaryMax                Int?
  currency                 String?
  salaryPeriod             SalaryPeriod?
  availability             Availability?
  portfolioUrl             String?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills ProfileSkill[]

  @@map("developer_profiles")
}

model ProfileSkill {
  id          String           @id @default(cuid())
  profileId   String
  name        String
  category    SkillCategory?
  proficiency SkillProficiency
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  profile DeveloperProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, name])
  @@map("profile_skills")
}

// ── Phase 3: Job Discovery ────────────────────────────────────────────────

model Job {
  id                String            @id @default(cuid())
  source            String
  sourceJobId       String?
  title             String
  companyName       String
  companyUrl        String?
  companyLogo       String?
  description       String
  location          String?
  country           String?
  remoteType        RemoteType        @default(UNKNOWN)
  employmentType    String?
  tags              String[]
  salaryMin         Int?
  salaryMax         Int?
  salaryCurrency    String?
  salaryPeriod      SalaryPeriod?
  salaryRaw         String?
  applicationUrl    String?
  originalUrl       String
  applicationMethod ApplicationMethod @default(EXTERNAL)
  status            JobStatus         @default(ACTIVE)
  postedAt          DateTime?
  discoveredAt      DateTime          @default(now())
  lastCheckedAt     DateTime          @default(now())
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  // Multi-provider freshness & verification
  canonicalUrl       String?
  sources            String[]          @default([])
  verificationStatus VerificationStatus @default(UNVERIFIED)
  lastSeenAt         DateTime?
  lastVerifiedAt     DateTime?
  // Relevance score (0-100) computed at ingestion — used to surface the best
  // matches for the user's saved developer profile, not just the newest rows.
  matchScore         Int?              @default(0)

  @@unique([source, sourceJobId])
  @@index([status])
  @@index([source])
  @@index([remoteType])
  @@index([postedAt])
  @@index([companyName])
  @@index([discoveredAt])
  @@index([canonicalUrl])
  @@index([verificationStatus])
  @@index([lastSeenAt])
  @@index([lastVerifiedAt])
  @@index([sourceJobId])
  @@index([country])
  @@index([location])
  @@index([title])
  @@index([matchScore])

  applications JobApplication[]

  @@map("jobs")
}

model SourceHealth {
  id            String   @id @default(cuid())
  sourceName    String   @unique
  status        String   @default("UNKNOWN")
  lastRunAt     DateTime?
  lastSuccessAt DateTime?
  lastErrorAt   DateTime?
  lastErrorMsg  String?
  jobsFetched   Int      @default(0)
  jobsNew       Int      @default(0)
  jobsDuplicate Int      @default(0)
  jobsExpired   Int      @default(0)
  jobsActive    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("source_health")
}

// ── Phase 4: Application Management ─────────────────────────────────────────

model ApplicationProfile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  phone                 String?
  education             String?
  certifications        String[]
  workExperience        Json? // [{ role, company, startDate, endDate, summary }]
  portfolioDescription  String?
  portfolioProjects     String[]
  githubUrl             String?
  githubRepos           String[]
  linkedinUrl           String?
  otherLinks            String[]
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("application_profiles")
}

model Resume {
  id        String   @id @default(cuid())
  userId    String
  name      String
  fileName  String
  fileType  String
  fileSize  Int
  fileData  Bytes // PDF/text bytes stored in Postgres (BYTEA)
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications JobApplication[]

  @@index([userId])
  @@map("resumes")
}

model CoverLetter {
  id        String   @id @default(cuid())
  userId    String
  name      String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications JobApplication[]

  @@index([userId])
  @@map("cover_letters")
}

model JobApplication {
  id                 String            @id @default(cuid())
  userId             String
  jobId              String?
  status             ApplicationStatus @default(SAVED)

  // Job snapshot — survives even if the source job is later removed
  jobTitle           String
  companyName        String
  location           String?
  source             String
  originalUrl        String
  applicationUrl     String?
  applicationMethod  ApplicationMethod @default(UNKNOWN)

  appliedAt          DateTime?
  cvId               String?
  coverLetterId      String?
  message            String?
  notes              String?
  interviewDate      DateTime?
  followUpDate       DateTime?
  recruiterInfo      String?

  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  job         Job?         @relation(fields: [jobId], references: [id], onDelete: SetNull)
  cv          Resume?      @relation(fields: [cvId], references: [id], onDelete: SetNull)
  coverLetter CoverLetter? @relation(fields: [coverLetterId], references: [id], onDelete: SetNull)
  interviews  Interview[]

  @@unique([userId, jobId])
  @@index([userId, status])
  @@index([userId, appliedAt])
  @@map("job_applications")
}

model Interview {
  id            String        @id @default(cuid())
  applicationId String
  type          InterviewType @default(VIDEO)
  scheduledAt   DateTime
  location      String?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  application JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("interviews")
}

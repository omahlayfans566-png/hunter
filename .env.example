# ─────────────────────────────────────────────
# AI Developer Job Hunter — Environment Variables
# Copy this file to server/.env and fill in real values.
# NEVER commit server/.env to version control.
# ─────────────────────────────────────────────

# ── Server ────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Database (MongoDB Atlas) ──────────────────
# Format: mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/DATABASE_NAME
MONGODB_URI="mongodb+srv://USERNAME:PASSWORD@cluster0.XXXXX.mongodb.net/job-hunter?retryWrites=true&w=majority"

# ── Authentication ─────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────
# Set to your Render frontend URL in production
CLIENT_URL=http://localhost:5173

# ─────────────────────────────────────────────────────
# JOB SOURCES — FREE (no key required)
# ─────────────────────────────────────────────────────

# The Muse — optional key for higher rate limits
THEMUSE_API_KEY=

# Greenhouse — override default company boards (comma-separated slugs)
# GREENHOUSE_BOARDS=airbnb,canonical,stripe,vercel,figma,notion

# Lever — override default companies (comma-separated slugs)
# LEVER_COMPANIES=toptal,automattic,doist,remote,toggl

# Days before unseen active jobs are marked expired (default: 14)
# JOB_STALE_AFTER_DAYS=14

# ─────────────────────────────────────────────────────
# JOB SOURCES — REQUIRE API KEYS
# ─────────────────────────────────────────────────────

# Jooble — FREE registration: https://jooble.org/api/about
# Covers: Nigeria, UK, USA, Canada, Europe, Remote worldwide
JOOBLE_API_KEY=

# Adzuna — FREE registration: https://developer.adzuna.com
# Covers: UK, USA, Australia, Canada, Germany, France, India, South Africa + 9 more
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Override countries (comma-separated Adzuna codes):
# ADZUNA_COUNTRIES=gb,us,ca,au,de,fr,in,za,nl,ie

# USAJobs — FREE: https://developer.usajobs.gov/apirequest/
# Covers: US government software developer positions
USAJOBS_EMAIL=
USAJOBS_KEY=

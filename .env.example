# ─────────────────────────────────────────────
# AI Developer Job Hunter — Environment Variables
# Copy this file to server/.env and fill in real values.
# NEVER commit server/.env to version control.
# ─────────────────────────────────────────────

# ── Server ────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Database (MongoDB Atlas) ──────────────────
# Format: mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/DATABASE_NAME
# Get this from: MongoDB Atlas → Cluster → Connect → Connect your application
MONGODB_URI="mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/job-hunter?retryWrites=true&w=majority"

# ── Authentication ─────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ── Phase 3: Job Sources (all optional) ───────
# The Muse API key — leave blank to use free tier (lower rate limits)
THEMUSE_API_KEY=

# Adzuna — leave blank to skip Adzuna source
# ADZUNA_APP_ID=your_app_id
# ADZUNA_APP_KEY=your_app_key

# USAJobs — leave blank to skip USAJobs source
# USAJOBS_EMAIL=your_email
# USAJOBS_KEY=your_api_key

# Greenhouse boards override (comma-separated company slugs)
# GREENHOUSE_BOARDS=airbnb,canonical,coinbase

# Lever companies override (comma-separated company slugs)
# LEVER_COMPANIES=toptal

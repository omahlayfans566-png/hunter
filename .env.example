# ─────────────────────────────────────────────
# AI Developer Job Hunter — Environment Variables
# Copy this file to server/.env and fill in real values.
# NEVER commit server/.env to version control.
# ─────────────────────────────────────────────

# ── Server ────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Database (Supabase PostgreSQL) ────────────
# Pooled connection — used by Prisma at runtime (pgBouncer)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Direct connection — used by Prisma Migrate only
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ── Authentication ─────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────
CLIENT_URL=http://localhost:5173
